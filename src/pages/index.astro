---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import GoogleReviewsEmbed from '../components/GoogleReviewsEmbed.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import PressStrip from '../components/PressStrip.astro';
import { site } from '../data/site';
import { featuredProducts, products } from '../data/products';
import { buildAggregateRatingSchema } from '../lib/featurable';
import { getEntry } from 'astro:content';

// Contenu éditorial extrait dans src/content/static-pages/index.md
// (éditable via Sveltia CMS → collection Pages du site → Page d'accueil).
const entry = await getEntry('static-pages', 'index');
if (!entry) throw new Error("Contenu manquant : src/content/static-pages/index.md");
const {
  meta,
  heroHome,
  carouselSection,
  historySection,
  introVideoSection,
  coffretTeaser,
  cocktailsSection,
  visitSection,
  ctaSection,
  featuredSection,
} = entry.data;

// AggregateRating injecté UNIQUEMENT à partir des vrais avis Google
// (via Featurable). Si l'API est down ou le widget non configuré, on
// renvoie null et la propriété est omise du schema.
const aggregateRating = await buildAggregateRatingSchema();

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'Organization'],
  '@id': `${site.url}#localbusiness`,
  name: site.name,
  alternateName: [site.shortName, 'Liquoristes artisanaux du Velay'],
  description: site.defaultDescription,
  slogan: site.slogan,
  keywords: site.keywords.join(', '),
  image: [new URL(site.defaultOgImage, site.url).toString()],
  logo: new URL('/images/brand/logo-complet-fond-blanc.webp', site.url).toString(),
  url: site.url,
  telephone: site.phone,
  email: site.email,
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Credit Card, Apple Pay, Google Pay, PayPal, SEPA',
  foundingDate: site.founded,
  founders: site.founders.map((f) => ({ '@type': 'Person', name: f })),
  award: `${site.award.title} ${site.award.year} — ${site.award.issuer}`,
  sameAs: [site.social.instagram, site.social.facebook, site.googleBusiness.url],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.latitude,
    longitude: site.geo.longitude,
  },
  hasMap: site.googleBusiness.url,
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Google Place ID',
    value: site.googleBusiness.placeId,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Wednesday', 'Friday', 'Saturday'],
      opens: '09:00',
      closes: '18:30',
    },
  ],
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'Country', name: 'Belgium' },
    { '@type': 'Country', name: 'Switzerland' },
    { '@type': 'Country', name: 'Luxembourg' },
  ],
  taxID: site.siret,
  vatID: 'FR67899201529',
  ...(aggregateRating ? { aggregateRating } : {}),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: 'Liqueurs artisanales La Brasserie des Plantes',
  url: site.url,
  inLanguage: 'fr-FR',
  publisher: { '@id': `${site.url}#localbusiness` },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${site.url}/boutique?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: "Visite de l'atelier — La Brasserie des Plantes",
  description:
    "Tour des cuves, du séchage des plantes et de l'embouteillage dans notre atelier de Saint-Didier-en-Velay (Haute-Loire).",
  thumbnailUrl: new URL('/videos/lbdp-pro-poster.jpg', site.url).toString(),
  contentUrl: new URL('/videos/lbdp-pro.mp4', site.url).toString(),
  uploadDate: '2025-04-18',
  duration: 'PT1M32S',
  inLanguage: 'fr-FR',
  publisher: { '@id': `${site.url}#localbusiness` },
};

const schema = [localBusinessSchema, websiteSchema, videoSchema];

// Rendu markdown inline minimal (bold + italic) pour les paragraphes CMS.
const renderInline = (s: string) =>
  s
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-medium text-forest-800">$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');

// Variante pour le hero (fond sombre, texte crème/or) — mêmes règles gras/italique
// mais couleur adaptée au fond.
const renderInlineHero = (s: string) =>
  s
    .replace(/\*\*(.+?)\*\*/g, '<strong class="text-gold-300 font-medium">$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');

// Interpolation {{address}} / {{city}} dans le paragraphe visitSection.
const interpolateVisit = (s: string | undefined) =>
  s
    ? s.replace(/\{\{address\}\}/g, site.address.street).replace(/\{\{city\}\}/g, site.address.city)
    : s;

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  site.address.street + ', ' + site.address.postalCode + ' ' + site.address.city
)}`;
---
<Layout
  title={meta.title}
  description={meta.description}
  schema={schema}
  hasHero={true}
  preloadImage={heroHome?.videoPoster ?? '/videos/lbdp-pro-poster.jpg'}
>
  <!-- HERO VIDÉO plein écran -->
  {heroHome && (
    <section class="relative min-h-[100dvh] w-full overflow-hidden bg-forest-950">
      {heroHome.video && (
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroHome.videoPoster}
          class="absolute inset-0 w-full h-full object-cover"
        >
          <source src={heroHome.video} type="video/mp4" />
        </video>
      )}
      <div class="absolute inset-0 bg-gradient-to-b from-forest-950/70 via-forest-950/40 to-forest-950/80"></div>

      <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6 text-cream-100 py-20 min-h-[100dvh]">
        {heroHome.badge && (
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gold-500/20 border border-gold-500/50 text-gold-400 text-xs font-medium tracking-[0.2em] uppercase mb-6 backdrop-blur-sm">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z"/></svg>
            {heroHome.badge}
          </div>
        )}
        {heroHome.logo && (
          <img
            src={heroHome.logo}
            alt={heroHome.logoAlt ?? 'La Brasserie des Plantes'}
            width="527"
            height="600"
            class="h-24 md:h-32 lg:h-36 w-auto mb-6 drop-shadow-[0_6px_24px_rgba(0,0,0,0.45)]"
            loading="eager"
            decoding="async"
          />
        )}
        <h1 class="font-display leading-[1.05] mb-6">
          <em class="not-italic text-cream-50 font-normal block text-5xl sm:text-6xl md:text-7xl lg:text-8xl sm:whitespace-nowrap leading-[1.1]" style="font-family: var(--font-script);">{heroHome.titleScript}</em>
          {heroHome.titleAccent && (
            <span class="text-gold-400 block text-3xl sm:text-4xl md:text-6xl lg:text-7xl mt-3 leading-tight" set:html={heroHome.titleAccent}></span>
          )}
        </h1>
        {heroHome.intro && (
          <p class="text-lg md:text-xl text-cream-100/90 max-w-2xl leading-relaxed mb-10" set:html={renderInlineHero(heroHome.intro)}></p>
        )}
        <div class="flex flex-wrap justify-center gap-4">
          {heroHome.ctaPrimaryLabel && heroHome.ctaPrimaryHref && (
            <a href={heroHome.ctaPrimaryHref} class="inline-flex items-center gap-2 px-7 py-4 rounded-full bg-cream-50 text-forest-900 hover:bg-cream-100 font-medium transition-all shadow-xl">
              {heroHome.ctaPrimaryLabel}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
            </a>
          )}
          {heroHome.ctaSecondaryLabel && heroHome.ctaSecondaryHref && (
            <a href={heroHome.ctaSecondaryHref} class="inline-flex items-center gap-2 px-7 py-4 rounded-full border border-cream-100/50 hover:bg-cream-100/10 text-cream-100 font-medium transition-colors backdrop-blur-sm">
              {heroHome.ctaSecondaryLabel}
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- CAROUSEL PRODUITS -->
  {carouselSection && (
    <ProductCarousel
      items={products.filter((p) => p.range !== 'accessoire')}
      kicker={carouselSection.kicker}
      heading={carouselSection.heading}
      subtitle={carouselSection.subtitle}
    />
  )}

  <!-- HISTOIRE -->
  {historySection && (
    <section class="py-24 bg-cream-50">
      <div class="max-w-3xl mx-auto px-6 text-center">
        {historySection.divider && (
          <div class="gold-divider mb-8">
            <span class="font-display italic text-xs uppercase tracking-[0.3em] text-gold-600">{historySection.divider}</span>
          </div>
        )}
        <h2 class="font-display text-4xl md:text-5xl text-forest-900 mb-8 leading-tight" set:html={historySection.title}></h2>
        <div class="space-y-6 text-lg text-ink-700 leading-relaxed">
          {historySection.paragraphs.map((p) => (
            <p set:html={renderInline(p)} />
          ))}
        </div>
        {historySection.links.length > 0 && (
          <div class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm">
            {historySection.links.map((l) => (
              <a href={l.href} class="inline-flex items-center gap-1.5 text-forest-700 hover:text-forest-900 font-medium border-b border-forest-300 hover:border-forest-700 pb-0.5 transition-colors">
                {l.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- BANDEAU VIDÉO INTRO -->
  {introVideoSection && (
    <section class="relative py-0 bg-forest-950 overflow-hidden">
      <div class="relative w-full aspect-[21/9] md:aspect-[21/8] max-h-[85vh]">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="none"
          poster={introVideoSection.poster}
          class="absolute inset-0 w-full h-full object-cover"
        >
          <source src={introVideoSection.video} type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-b from-forest-950/65 via-forest-950/25 to-forest-950/80"></div>
        <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6 text-cream-100">
          {introVideoSection.script && (
            <span style="font-family: var(--font-script);" class="text-gold-400 text-3xl md:text-4xl mb-3">{introVideoSection.script}</span>
          )}
          <h2 class="font-display text-4xl md:text-6xl leading-tight max-w-4xl mb-4 text-cream-100">
            {introVideoSection.title}
            {introVideoSection.titleAccent && (
              <><br /><em class="not-italic text-gold-400 font-normal" style="font-family: var(--font-script);">{introVideoSection.titleAccent}</em></>
            )}
          </h2>
          {introVideoSection.tagline && (
            <p class="text-cream-100/85 text-base md:text-lg max-w-2xl leading-relaxed">
              {introVideoSection.tagline}
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- AVIS GOOGLE -->
  <GoogleReviewsEmbed />

  <!-- COFFRET DIY -->
  {coffretTeaser && (
    <section class="py-20 md:py-28 bg-cream-50 relative overflow-hidden">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-forest-200 to-transparent" aria-hidden="true"></div>
      <div class="relative max-w-6xl mx-auto px-6 grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-20 items-center">
        <div>
          {coffretTeaser.kicker && (
            <div class="text-[10px] uppercase tracking-[0.35em] text-gold-600 font-medium mb-5">
              {coffretTeaser.kicker}
            </div>
          )}
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-forest-900 mb-6">
            {coffretTeaser.title}
            {coffretTeaser.titleAccent && (
              <><br /><em class="not-italic font-normal text-forest-600" style="font-family: var(--font-script);">{coffretTeaser.titleAccent}</em></>
            )}
          </h2>
          {coffretTeaser.intro && (
            <p class="text-ink-700 text-base md:text-lg leading-relaxed mb-10 max-w-md">
              {coffretTeaser.intro}
            </p>
          )}
          <div class="flex flex-wrap gap-3 items-center">
            {coffretTeaser.ctaPrimaryLabel && coffretTeaser.ctaPrimaryHref && (
              <a
                href={coffretTeaser.ctaPrimaryHref}
                class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-forest-900 hover:bg-forest-800 text-cream-50 text-sm font-medium transition-colors group"
              >
                {coffretTeaser.ctaPrimaryLabel}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-0.5 transition-transform">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            )}
            {coffretTeaser.ctaSecondaryLabel && coffretTeaser.ctaSecondaryHref && (
              <a
                href={coffretTeaser.ctaSecondaryHref}
                class="inline-flex items-center gap-1.5 px-5 py-3.5 text-forest-800 hover:text-forest-900 text-sm font-medium underline decoration-gold-500 decoration-1 underline-offset-4 hover:decoration-2 transition-all"
              >
                {coffretTeaser.ctaSecondaryLabel}
              </a>
            )}
          </div>
        </div>

        {coffretTeaser.stackImages.length >= 3 && (
          <div class="relative flex items-center justify-center">
            <div class="relative" style="width: 120px;">
              <img
                src={coffretTeaser.stackImages[0].src}
                alt={coffretTeaser.stackImages[0].alt}
                class="relative block mx-auto w-full h-auto"
                style="filter: drop-shadow(0 8px 14px rgba(10, 107, 67, 0.22)); z-index: 3;"
                loading="lazy"
              />
              <img
                src={coffretTeaser.stackImages[1].src}
                alt={coffretTeaser.stackImages[1].alt}
                class="relative block mx-auto w-full h-auto -mt-[27%]"
                style="filter: drop-shadow(0 8px 14px rgba(10, 107, 67, 0.22)); z-index: 2;"
                loading="lazy"
              />
              <img
                src={coffretTeaser.stackImages[2].src}
                alt={coffretTeaser.stackImages[2].alt}
                class="relative block mx-auto w-full h-auto -mt-[27%]"
                style="filter: drop-shadow(0 8px 14px rgba(10, 107, 67, 0.22)); z-index: 1;"
                loading="lazy"
              />
              <div
                class="mx-auto mt-1.5 h-2.5 rounded-full pointer-events-none"
                style="width: 85%; background: radial-gradient(ellipse, rgba(10, 107, 67, 0.28), transparent 65%);"
                aria-hidden="true"
              ></div>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- COCKTAILS -->
  {cocktailsSection && (
    <section class="py-24 bg-cream-100/60">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
        <div>
          {cocktailsSection.kicker && (
            <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{cocktailsSection.kicker}</div>
          )}
          <h2 class="font-display text-4xl md:text-5xl text-forest-900 mb-6 leading-tight" set:html={cocktailsSection.title}></h2>
          {cocktailsSection.intro && (
            <p class="text-lg text-ink-700 leading-relaxed mb-8">
              {cocktailsSection.intro}
            </p>
          )}
          {cocktailsSection.ctaLabel && cocktailsSection.ctaHref && (
            <a href={cocktailsSection.ctaHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-forest-700/40 hover:border-forest-700 text-forest-900 font-medium transition-colors">
              {cocktailsSection.ctaLabel}
            </a>
          )}
        </div>
        <div class="grid grid-cols-2 gap-4">
          {cocktailsSection.cocktails.map((c) => (
            <a href={c.href} class:list={["group aspect-square rounded-2xl overflow-hidden relative bg-forest-50 hover:shadow-xl transition-shadow", c.offset && 'mt-8']}>
              <img src={c.image} alt={`Cocktail ${c.title}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-forest-900/80 via-forest-900/20 to-transparent"></div>
              <h3 class="absolute bottom-4 left-4 right-4 font-display text-lg text-cream-50 leading-tight">{c.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- VISITE BOUTIQUE -->
  {visitSection && (
    <section class="py-20 md:py-24 bg-cream-50">
      <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        {visitSection.video && (
          <div class="aspect-[4/5] sm:aspect-[4/3] lg:aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl bg-forest-950 order-2 lg:order-1">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="none"
              poster={visitSection.videoPoster}
              aria-label={visitSection.videoAlt}
              class="w-full h-full object-cover"
            >
              <source src={visitSection.video} type="video/mp4" />
            </video>
          </div>
        )}
        <div class="order-1 lg:order-2">
          {visitSection.kicker && (
            <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{visitSection.kicker}</div>
          )}
          <h2 class="font-display text-4xl md:text-5xl text-forest-900 leading-tight mb-6">
            {visitSection.title}
            {visitSection.titleAccent && (
              <> <em class="not-italic text-forest-600 font-normal" style="font-family: var(--font-script);">{visitSection.titleAccent}</em></>
            )}
          </h2>
          {visitSection.intro && (
            <p class="text-lg text-ink-700 leading-relaxed mb-8" set:html={renderInline(interpolateVisit(visitSection.intro)!)}></p>
          )}
          <dl class="grid sm:grid-cols-2 gap-5 mb-10 text-sm">
            <div>
              <dt class="text-xs uppercase tracking-wider text-forest-600 font-medium mb-1.5">{visitSection.addressLabel ?? 'Adresse'}</dt>
              <dd class="text-ink-700 leading-relaxed">
                {site.address.street}<br />{site.address.postalCode} {site.address.city}
              </dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider text-forest-600 font-medium mb-1.5">{visitSection.hoursLabel ?? 'Horaires'}</dt>
              <dd class="text-ink-700 leading-relaxed">{site.hoursDisplay}</dd>
            </div>
          </dl>
          <div class="flex flex-wrap gap-3">
            {visitSection.ctaPrimaryLabel && (
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-forest-800 hover:bg-forest-900 text-cream-100 font-medium transition-colors"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {visitSection.ctaPrimaryLabel}
              </a>
            )}
            {visitSection.ctaSecondaryLabel && visitSection.ctaSecondaryHref && (
              <a href={visitSection.ctaSecondaryHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-forest-700/40 hover:border-forest-700 text-forest-900 font-medium transition-colors">
                {visitSection.ctaSecondaryLabel}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- INSTAGRAM -->
  <InstagramFeed variant="light" />

  <!-- CTA FINAL -->
  {ctaSection && (
    <section class="py-24 bg-gradient-to-br from-forest-800 via-forest-900 to-forest-950 text-cream-100 relative overflow-hidden">
      <div class="relative max-w-4xl mx-auto px-6 text-center">
        {ctaSection.script && (
          <span style="font-family: var(--font-script);" class="text-gold-400 text-2xl">{ctaSection.script}</span>
        )}
        <h2 class="font-display text-4xl md:text-5xl mt-4 mb-6 leading-tight text-cream-100" set:html={ctaSection.title}></h2>
        {ctaSection.intro && (
          <p class="text-cream-200/80 text-lg mb-10 max-w-2xl mx-auto leading-relaxed">
            {ctaSection.intro}
          </p>
        )}
        {ctaSection.ctaPrimaryLabel && ctaSection.ctaPrimaryHref && (
          <a href={ctaSection.ctaPrimaryHref} class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-cream-50 hover:bg-cream-100 text-forest-900 font-medium transition-all hover:shadow-2xl">
            {ctaSection.ctaPrimaryLabel}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        )}
      </div>
    </section>
  )}

  <!-- ILS PARLENT DE NOUS -->
  <PressStrip />

  <!-- PRODUITS VEDETTES -->
  {featuredSection && (
    <section class="py-24 bg-gradient-to-b from-forest-50/50 to-cream-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
          <div>
            {featuredSection.kicker && (
              <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{featuredSection.kicker}</div>
            )}
            <h2 class="font-display text-4xl md:text-5xl text-forest-900 leading-tight">{featuredSection.title}</h2>
          </div>
          {featuredSection.seeAllLabel && featuredSection.seeAllHref && (
            <a href={featuredSection.seeAllHref} class="inline-flex items-center gap-2 text-forest-700 hover:text-forest-900 font-medium">
              {featuredSection.seeAllLabel}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
          {featuredProducts.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</Layout>
