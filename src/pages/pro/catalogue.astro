---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';

/**
 * Viewer catalogue pro — affiche le PDF fusionné (catalogue général + coffrets
 * entreprise) en iframe pleine largeur avec toolbar désactivée (`#toolbar=0`).
 *
 * Objectif : consultation en ligne sans bouton "Télécharger" visible dans
 * le viewer PDF du navigateur. NB : le PDF reste techniquement accessible
 * via l'URL directe ou l'inspecteur réseau — c'est un frein UX, pas une
 * protection DRM. Acceptable pour un catalogue commercial.
 *
 * Page volontairement pas indexée (noindex via le champ noindex du Layout).
 */

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Professionnels', item: `${site.url}/professionnels` },
    { '@type': 'ListItem', position: 3, name: 'Catalogue', item: `${site.url}/pro/catalogue` },
  ],
};
---
<Layout
  title="Catalogue Professionnels 2025 — La Brasserie des Plantes"
  description="Catalogue complet des liqueurs, formats et coffrets entreprise — réservé aux partenaires professionnels."
  schema={[breadcrumb]}
  noindex={true}
>
  <!-- Bandeau léger : breadcrumb + CTA retour -->
  <section class="bg-cream-50 border-b border-forest-100/60 py-5">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between gap-4 flex-wrap">
      <nav class="text-xs text-ink-500" aria-label="Fil d'Ariane">
        <a href="/" class="hover:text-forest-700">Accueil</a>
        <span class="mx-2">/</span>
        <a href="/professionnels" class="hover:text-forest-700">Professionnels</a>
        <span class="mx-2">/</span>
        <span class="text-forest-700">Catalogue 2025</span>
      </nav>
      <div class="flex items-center gap-4 text-xs text-ink-500">
        <span class="hidden sm:inline">Catalogue réservé aux partenaires pros</span>
        <a
          href="/professionnels#contact"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-forest-800 hover:bg-forest-900 text-cream-100 font-medium transition-colors"
        >
          Demander un devis
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Viewer PDF — deux rendus distincts selon le device :
       Desktop (md+) : <object>/<iframe> PDF avec toolbar désactivée.
       Mobile (<md)  : gros bouton "Ouvrir le catalogue" qui déclenche le
                       viewer PDF natif du téléphone. Les navigateurs mobile
                       (Chrome Android, Safari iOS) BLOQUENT l'iframe/object
                       PDF depuis 2023 → "Ce contenu est bloqué" au lieu du
                       PDF. Le fallback dans <object> ne se déclenche pas
                       non plus car techniquement l'iframe est "chargée",
                       juste bloquée par le navigateur. Seule solution UX
                       propre : afficher directement le lien plein écran. -->
  <section
    id="catalogue-viewer"
    class="relative bg-forest-950 select-none py-6 md:py-8"
    oncontextmenu="return false;"
  >
    <!-- Desktop : viewer intégré (iframe/object) -->
    <div class="hidden md:block">
      <object
        data="/catalogues/catalogue-pro-2025.pdf#toolbar=0&navpanes=0&scrollbar=1&view=Fit"
        type="application/pdf"
        title="Catalogue professionnels 2025 — La Brasserie des Plantes"
        class="block w-full mx-auto border-0 shadow-2xl rounded-sm bg-white"
        style="max-width: 960px; height: calc(100vh - 140px);"
      >
        <iframe
          src="/catalogues/catalogue-pro-2025.pdf#toolbar=0&navpanes=0&scrollbar=1&view=Fit"
          title="Catalogue professionnels 2025 — La Brasserie des Plantes"
          class="block w-full mx-auto border-0 shadow-2xl rounded-sm bg-white"
          style="max-width: 960px; height: calc(100vh - 140px);"
          loading="lazy"
        ></iframe>
        <div class="text-center py-12 px-6 bg-cream-50 max-w-2xl mx-auto rounded-lg">
          <p class="text-ink-700 mb-4">
            Votre navigateur ne peut pas afficher le PDF en ligne.
          </p>
          <a
            href="/catalogues/catalogue-pro-2025.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-forest-800 hover:bg-forest-900 text-cream-100 font-medium transition-colors"
          >
            Ouvrir le catalogue dans un nouvel onglet
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
      </object>
    </div>

    <!-- Mobile : gros bouton dédié (l'iframe PDF est bloquée par les
         navigateurs mobile depuis 2023, mieux vaut ouvrir en plein écran) -->
    <div class="md:hidden max-w-md mx-auto px-4">
      <div class="text-center py-12 px-6 bg-cream-50 rounded-2xl shadow-xl">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-forest-800 text-cream-50 mb-5">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="9" y1="15" x2="15" y2="15"/>
            <line x1="9" y1="11" x2="15" y2="11"/>
          </svg>
        </div>
        <h2 class="font-display text-2xl text-forest-900 mb-3 leading-tight">
          Catalogue Pro 2025
        </h2>
        <p class="text-sm text-ink-700 mb-6 leading-relaxed">
          Sur mobile, le catalogue s'ouvre en plein écran dans votre lecteur PDF pour une meilleure lecture.
        </p>
        <a
          href="/catalogues/catalogue-pro-2025.pdf"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 w-full justify-center px-6 py-4 rounded-full bg-forest-800 hover:bg-forest-900 text-cream-100 font-medium transition-colors"
        >
          Ouvrir le catalogue
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </a>
        <p class="text-[11px] text-ink-500 mt-4">
          Format PDF · Une fois ouvert, vous pourrez zoomer, pincer, feuilleter.
        </p>
      </div>
    </div>

    <noscript>
      <p class="text-center text-cream-100 py-6">
        <a href="/catalogues/catalogue-pro-2025.pdf" class="underline">Télécharger le catalogue PDF</a>
      </p>
    </noscript>
  </section>

  <!-- Lien de secours systématique : visible même si l'embed marche, comme
       option pour ouvrir le PDF en plein écran (utile sur mobile où l'iframe
       PDF est souvent peu agréable à lire). -->
  <section class="bg-forest-950 text-cream-100/80 text-center text-sm py-4 border-t border-cream-100/10">
    <a
      href="/catalogues/catalogue-pro-2025.pdf"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 hover:text-cream-100 transition-colors"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Ouvrir le catalogue en plein écran
    </a>
  </section>

  <!-- Bandeau bas : rappel contact + retour -->
  <section class="bg-forest-900 text-cream-100 py-10">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-sm md:text-base text-cream-200/80 leading-relaxed mb-5">
        Vous avez trouvé des références qui vous intéressent ? Contactez-nous
        pour un devis personnalisé — nous revenons vers vous sous 48 heures.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a
          href="/professionnels#contact"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-cream-50 text-forest-900 hover:bg-cream-100 font-medium transition-colors"
        >
          Demander un devis
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a
          href={`tel:${site.phone}`}
          class="inline-flex flex-col items-center gap-0.5 px-6 py-2.5 rounded-full border border-cream-100/40 hover:bg-cream-100/10 text-cream-100 font-medium transition-colors"
        >
          <span>{site.phoneDisplay}</span>
          <span class="text-[10px] font-normal text-cream-200/70">Mer · Ven · Sam 9h–18h30</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Désactive le raccourci Ctrl/Cmd+S (save) sur la page viewer. UX plutôt
  // que DRM : un utilisateur déterminé contournera, mais ça empêche le geste
  // réflexe "je sauvegarde le PDF".
  document.addEventListener('keydown', (e) => {
    const isSave = (e.ctrlKey || e.metaKey) && (e.key === 's' || e.key === 'S');
    if (isSave) {
      e.preventDefault();
      e.stopPropagation();
    }
  });
</script>
