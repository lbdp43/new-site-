---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('static-pages', 'mentions-legales');
if (!entry) throw new Error("Contenu manquant : src/content/static-pages/mentions-legales.md");
const { meta, pageHeader } = entry.data;
const { Content } = await render(entry);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Mentions légales — ${site.name}`,
  url: `${site.url}/mentions-legales`,
  inLanguage: 'fr-FR',
};

const updatedDate = new Date().toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout
  title={meta.title}
  description={meta.description}
  schema={schema}
  noindex={false}
>
  {pageHeader && (
    <PageHeader
      kicker={pageHeader.kicker}
      title={pageHeader.title}
      subtitle={pageHeader.subtitle}
      breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Mentions légales' }]}
    />
  )}

  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 prose prose-lg prose-headings:font-display prose-headings:text-forest-900 prose-h2:text-2xl prose-h2:mt-10 prose-a:text-forest-700 prose-strong:text-forest-900 prose-blockquote:border-l-4 prose-blockquote:border-gold-500 prose-blockquote:bg-gold-500/5 prose-blockquote:py-1 prose-blockquote:not-italic prose-blockquote:text-sm">
      <Content />
      <p class="text-xs text-ink-500 mt-12">Dernière mise à jour : {updatedDate}.</p>
    </div>
  </section>
</Layout>
