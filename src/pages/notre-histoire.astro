---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { getEntry } from 'astro:content';

const entry = await getEntry('static-pages', 'notre-histoire');
if (!entry) throw new Error("Contenu manquant : src/content/static-pages/notre-histoire.md");
const {
  meta,
  pageHeader,
  videoHero,
  stats,
  storySections,
  distinctionsSection,
  teamSection,
  gallerySection,
  ctaSection,
} = entry.data;

// ─── Schema.org ───────────────────────────────────────────────────────
// AboutPage + BreadcrumbList + Person pour les 2 fondateurs.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `Notre histoire — ${site.name}`,
    url: `${site.url}/notre-histoire`,
    description:
      "L'histoire de La Brasserie des Plantes, fondée en 2021 par Étienne et Guillaume à Saint-Didier-en-Velay (Haute-Loire). Liqueurs artisanales bio, Meilleur Digestif du Monde 2025.",
    about: { '@id': `${site.url}#localbusiness` },
    mainEntity: [
      { '@id': `${site.url}#etienne` },
      { '@id': `${site.url}#guillaume` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}#etienne`,
    name: 'Étienne',
    jobTitle: 'Cofondateur, artisan liquoriste',
    image: new URL('/images/team/portrait-etienne.webp', site.url).toString(),
    description:
      "Cofondateur de La Brasserie des Plantes. Formé en biotechnologie végétale à Toulouse, il compose les recettes, choisit les plantes et supervise l'ensemble de la production.",
    worksFor: { '@id': `${site.url}#localbusiness` },
    knowsAbout: [
      'Biotechnologie végétale',
      'Macération des plantes',
      'Assemblage de liqueurs artisanales',
      'Liqueurs de plantes',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site.url}#guillaume`,
    name: 'Guillaume',
    jobTitle: 'Cofondateur, accords et usages',
    image: new URL('/images/team/portrait-guillaume.webp', site.url).toString(),
    description:
      "Cofondateur de La Brasserie des Plantes. Venu de la restauration et du bar à Saint-Étienne, il conçoit les accords, le discours produit et les partenariats CHR.",
    worksFor: { '@id': `${site.url}#localbusiness` },
    knowsAbout: [
      'Mixologie',
      'Accords mets-liqueurs',
      'Restauration',
      'Développement commercial spiritueux',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Notre histoire', item: `${site.url}/notre-histoire` },
    ],
  },
];

const tierStyles: Record<string, { bg: string; text: string; border: string; ring: string }> = {
  gold: { bg: 'bg-gold-500/15', text: 'text-gold-700', border: 'border-gold-500/40', ring: 'ring-gold-500/20' },
  silver: { bg: 'bg-ink-200/40', text: 'text-ink-600', border: 'border-ink-300/60', ring: 'ring-ink-300/30' },
};

// Rendu markdown inline minimal (bold + italic) pour les paragraphes du CMS.
const renderInline = (s: string) =>
  s
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-medium text-forest-800">$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');

// Insère un <br class="hidden sm:inline" /> après le mot indiqué dans la
// phrase calligraphiée du hero vidéo (« Ça fait plus de vingt ans<br />qu'on
// se connaît. »). Purement visuel — si absent, la phrase reste sur une ligne.
const scriptWithBreak = (script: string | undefined, after: string | undefined) => {
  if (!script) return '';
  if (!after) return script;
  const idx = script.indexOf(after);
  if (idx < 0) return script;
  const cut = idx + after.length;
  return script.slice(0, cut) + '<br class="hidden sm:inline" /> ' + script.slice(cut).trimStart();
};
---
<Layout
  title={meta.title}
  description={meta.description}
  schema={schema}
>
  {pageHeader && (
    <PageHeader
      kicker={pageHeader.kicker}
      title={pageHeader.title}
      subtitle={pageHeader.subtitle}
      breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Notre histoire' }]}
    />
  )}

  <!-- Vidéo hero bandeau -->
  {videoHero && (
    <section class="relative w-full bg-forest-950 overflow-hidden">
      <div class="relative aspect-[21/9] md:aspect-[21/8] w-full">
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={videoHero.poster}
          aria-label={videoHero.alt}
          class="absolute inset-0 w-full h-full object-cover object-top"
        >
          <source src={videoHero.src} type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-gradient-to-b from-forest-950/70 via-forest-950/30 to-forest-950/80"></div>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6 gap-3 md:gap-5">
          {videoHero.badge && (
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cream-50/15 border border-cream-100/30 text-cream-100 text-[10px] md:text-xs font-medium tracking-[0.25em] uppercase backdrop-blur-sm">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="4"/></svg>
              {videoHero.badge}
            </div>
          )}
          {videoHero.script && (
            <p class="text-cream-50 font-display text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-[1.05] drop-shadow-lg max-w-3xl">
              <em class="not-italic font-normal" style="font-family: var(--font-script);" set:html={scriptWithBreak(videoHero.script, videoHero.scriptLineBreakAfter)}></em>
            </p>
          )}
          {videoHero.tagline && (
            <p class="text-cream-100/85 text-sm md:text-lg leading-relaxed max-w-xl">
              {videoHero.tagline}
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Chiffres clés -->
  {stats && stats.length > 0 && (
    <section class="py-14 border-y border-forest-100/60 bg-cream-100/40">
      <div class="max-w-6xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {stats.map((s) => (
          <div>
            {s.isIcon ? (
              <div class="inline-flex items-center justify-center w-12 h-12 md:w-14 md:h-14 rounded-full bg-gold-500/15 text-gold-600">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"/>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                </svg>
              </div>
            ) : (
              <div class="font-display text-4xl md:text-5xl text-forest-800">{s.value}</div>
            )}
            <div class="text-xs uppercase tracking-wider text-ink-500 mt-2">{s.label}</div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Sections narratives alternées -->
  {(storySections ?? []).map((sec) => {
    const bgClass = sec.background === 'white' ? 'bg-white' : 'bg-cream-50';
    if (sec.layout === 'prose') {
      // Ancres pour Person.url des auteurs blog (uniquement première section prose).
      return (
        <section class={`py-20 ${bgClass}`}>
          <div class="max-w-3xl mx-auto px-6">
            <span id="etienne" class="sr-only" aria-hidden="true"></span>
            <span id="guillaume" class="sr-only" aria-hidden="true"></span>
            <div class="prose prose-lg max-w-none text-ink-700 space-y-6 leading-relaxed">
              {sec.kicker && (
                <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{sec.kicker}</div>
              )}
              <h2 class="font-display text-3xl md:text-4xl text-forest-900 mb-6 leading-tight">
                {sec.title}
                {sec.titleAccent && (
                  <><br /><em class="not-italic text-forest-600 font-normal" style="font-family: var(--font-script);">{sec.titleAccent}</em></>
                )}
              </h2>
              {sec.paragraphs.map((p) => (<p set:html={renderInline(p)} />))}
              {sec.linkLabel && sec.linkHref && (
                <p>
                  <a href={sec.linkHref} class="text-forest-700 font-medium hover:text-forest-900 underline decoration-forest-300 underline-offset-4">
                    {sec.linkLabel}
                  </a>
                </p>
              )}
            </div>
          </div>
        </section>
      );
    }
    const imageLeft = sec.layout === 'image-left';
    return (
      <section class={`py-20 ${bgClass}`}>
        <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
          <div class={imageLeft ? '' : 'order-2 md:order-1'}>
            {imageLeft ? (
              sec.image && (
                <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-xl">
                  <img src={sec.image} alt={sec.imageAlt ?? sec.title} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )
            ) : (
              <>
                {sec.kicker && (
                  <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{sec.kicker}</div>
                )}
                <h2 class="font-display text-3xl md:text-4xl text-forest-900 mb-6 leading-tight">
                  {sec.title}
                  {sec.titleAccent && (
                    <><br /><em class="not-italic text-forest-600 font-normal" style="font-family: var(--font-script);">{sec.titleAccent}</em></>
                  )}
                </h2>
                <div class="space-y-5 text-lg text-ink-700 leading-relaxed">
                  {sec.paragraphs.map((p) => (<p set:html={renderInline(p)} />))}
                  {sec.linkLabel && sec.linkHref && (
                    <p>
                      <a href={sec.linkHref} class="text-forest-700 font-medium hover:text-forest-900 underline decoration-forest-300 underline-offset-4">
                        {sec.linkLabel}
                      </a>
                    </p>
                  )}
                </div>
              </>
            )}
          </div>
          <div class={imageLeft ? '' : 'order-1 md:order-2'}>
            {imageLeft ? (
              <>
                {sec.kicker && (
                  <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{sec.kicker}</div>
                )}
                <h2 class="font-display text-3xl md:text-4xl text-forest-900 mb-6 leading-tight">
                  {sec.title}
                  {sec.titleAccent && (
                    <><br /><em class="not-italic text-forest-600 font-normal" style="font-family: var(--font-script);">{sec.titleAccent}</em></>
                  )}
                </h2>
                <div class="space-y-5 text-lg text-ink-700 leading-relaxed">
                  {sec.paragraphs.map((p) => (<p set:html={renderInline(p)} />))}
                  {sec.linkLabel && sec.linkHref && (
                    <p>
                      <a href={sec.linkHref} class="text-forest-700 font-medium hover:text-forest-900 underline decoration-forest-300 underline-offset-4">
                        {sec.linkLabel}
                      </a>
                    </p>
                  )}
                </div>
              </>
            ) : (
              sec.image && (
                <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-xl">
                  <img src={sec.image} alt={sec.imageAlt ?? sec.title} class="w-full h-full object-cover" loading="lazy" />
                </div>
              )
            )}
          </div>
        </div>
      </section>
    );
  })}

  <!-- Distinctions -->
  {distinctionsSection && (
    <section class="py-20 bg-gradient-to-b from-cream-50 to-gold-500/10 border-y border-gold-500/30">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14 max-w-3xl mx-auto">
          {distinctionsSection.kicker && (
            <div class="text-xs uppercase tracking-[0.25em] text-gold-600 font-medium mb-3">{distinctionsSection.kicker}</div>
          )}
          <h2 class="font-display text-3xl md:text-5xl text-forest-900 mb-6 leading-tight">
            {distinctionsSection.title}
            {distinctionsSection.titleAccent && (
              <><br /><em class="not-italic text-gold-600 font-normal" style="font-family: var(--font-script);">{distinctionsSection.titleAccent}</em></>
            )}
          </h2>
          <div class="space-y-4 text-lg text-ink-700 leading-relaxed">
            {distinctionsSection.paragraphs.map((p) => (
              <p set:html={renderInline(p)} />
            ))}
          </div>
        </div>

        {distinctionsSection.flagship && (
          <div class="grid md:grid-cols-2 gap-12 items-center mb-16">
            <div>
              <div class="aspect-[16/10] rounded-3xl overflow-hidden shadow-2xl">
                <img src={distinctionsSection.flagship.image} alt={distinctionsSection.flagship.imageAlt ?? distinctionsSection.flagship.title} class="w-full h-full object-cover" loading="lazy" />
              </div>
            </div>
            <div>
              {distinctionsSection.flagship.badge && (
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/20 border border-gold-500/50 text-gold-700 text-xs font-medium tracking-[0.15em] uppercase mb-4">
                  {distinctionsSection.flagship.badge}
                </div>
              )}
              <h3 class="font-display text-2xl md:text-3xl text-forest-900 mb-4 leading-tight">
                {distinctionsSection.flagship.title}
              </h3>
              <div class="space-y-4 text-ink-700 leading-relaxed">
                {distinctionsSection.flagship.paragraphs.map((p) => (
                  <p set:html={renderInline(p)} />
                ))}
              </div>
              {distinctionsSection.flagship.ctaLabel && distinctionsSection.flagship.ctaHref && (
                <div class="mt-6">
                  <a href={distinctionsSection.flagship.ctaHref} class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-forest-800 hover:bg-forest-900 text-cream-100 font-medium transition-colors">
                    {distinctionsSection.flagship.ctaLabel}
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        )}

        {distinctionsSection.productsWithMedals.length > 0 && (
          <div class="grid md:grid-cols-3 gap-6">
            {distinctionsSection.productsWithMedals.map((p) => (
              <article class="p-6 rounded-2xl bg-white border border-forest-100/60 hover:shadow-md transition-shadow flex flex-col">
                <div class="mb-4">
                  <h3 class="font-display text-2xl text-forest-900 leading-tight mb-1">
                    <a href={`/boutique/${p.slug}`} class="hover:text-forest-700 transition-colors">
                      {p.product}
                    </a>
                  </h3>
                  {p.tagline && (
                    <div class="text-xs uppercase tracking-[0.2em] text-gold-600 font-medium">
                      {p.tagline}
                    </div>
                  )}
                </div>
                {p.note && (
                  <p class="text-sm text-ink-600 italic leading-relaxed mb-4">{p.note}</p>
                )}
                <ul class="space-y-2.5 flex-1">
                  {p.medals.map((m) => {
                    const t = tierStyles[m.tier];
                    return (
                      <li class="flex items-start gap-3">
                        <span class={`flex-none mt-0.5 inline-flex items-center gap-1 px-2.5 py-1 rounded-full ${t.bg} ${t.text} text-[10px] font-medium tracking-wide uppercase`}>
                          {m.tier === 'gold' ? 'Or' : 'Argent'} {m.year}
                        </span>
                        <span class="text-sm text-ink-700 leading-snug">{m.competition}</span>
                      </li>
                    );
                  })}
                </ul>
                <a href={`/boutique/${p.slug}`} class="mt-5 pt-4 border-t border-forest-100/60 text-sm text-forest-700 font-medium hover:text-forest-900 inline-flex items-center gap-1.5">
                  Voir le produit
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              </article>
            ))}
          </div>
        )}

        {distinctionsSection.innovationAward && (
          <div class="mt-8 p-6 rounded-2xl bg-forest-50/60 border border-forest-200/60 flex flex-col sm:flex-row gap-5 items-start">
            <div class="flex-none inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-forest-500/15 text-forest-700">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5 2 7-6.5-4.5-6.5 4.5 2-7L2 9h7z"/></svg>
            </div>
            <div class="flex-1">
              <div class="text-xs uppercase tracking-[0.2em] text-forest-700 font-medium mb-1">Prix innovation · {distinctionsSection.innovationAward.year}</div>
              <h3 class="font-display text-xl text-forest-900 leading-tight mb-1">{distinctionsSection.innovationAward.title}</h3>
              {distinctionsSection.innovationAward.subtitle && (
                <div class="text-sm text-ink-500 mb-2">{distinctionsSection.innovationAward.subtitle}</div>
              )}
              {distinctionsSection.innovationAward.description && (
                <p class="text-sm text-ink-700 leading-relaxed">{distinctionsSection.innovationAward.description}</p>
              )}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Équipe -->
  {teamSection && (
    <section class="py-24 bg-forest-50/40">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16 max-w-2xl mx-auto">
          {teamSection.kicker && (
            <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{teamSection.kicker}</div>
          )}
          <h2 class="font-display text-4xl md:text-5xl text-forest-900 leading-tight">{teamSection.title}</h2>
          {teamSection.intro && (
            <p class="text-ink-600 mt-4 leading-relaxed">{teamSection.intro}</p>
          )}
        </div>

        {teamSection.members.map((m, i) => {
          const imageLeft = m.layout === 'image-left';
          const isLast = i === teamSection.members.length - 1;
          return (
            <div class={`grid md:grid-cols-2 gap-12 items-center ${isLast ? '' : 'mb-20'}`}>
              <div class={imageLeft ? '' : 'order-2 md:order-1'}>
                {imageLeft ? (
                  <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-xl">
                    <img src={m.image} alt={m.imageAlt ?? m.name} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ) : (
                  <>
                    {m.kicker && (
                      <div class="text-xs uppercase tracking-[0.25em] text-gold-600 font-medium mb-3">{m.kicker}</div>
                    )}
                    <h3 class="font-display text-4xl md:text-5xl text-forest-900 mb-4 leading-tight">{m.name}</h3>
                    {m.role && (
                      <div class="text-sm text-forest-700 font-medium mb-5 tracking-wide">{m.role}</div>
                    )}
                    <div class="space-y-4 text-lg text-ink-700 leading-relaxed">
                      {m.paragraphs.map((p) => (<p set:html={renderInline(p)} />))}
                    </div>
                  </>
                )}
              </div>
              <div class={imageLeft ? '' : 'order-1 md:order-2'}>
                {imageLeft ? (
                  <>
                    {m.kicker && (
                      <div class="text-xs uppercase tracking-[0.25em] text-gold-600 font-medium mb-3">{m.kicker}</div>
                    )}
                    <h3 class="font-display text-4xl md:text-5xl text-forest-900 mb-4 leading-tight">{m.name}</h3>
                    {m.role && (
                      <div class="text-sm text-forest-700 font-medium mb-5 tracking-wide">{m.role}</div>
                    )}
                    <div class="space-y-4 text-lg text-ink-700 leading-relaxed">
                      {m.paragraphs.map((p) => (<p set:html={renderInline(p)} />))}
                    </div>
                  </>
                ) : (
                  <div class="aspect-[4/5] rounded-3xl overflow-hidden shadow-xl">
                    <img src={m.image} alt={m.imageAlt ?? m.name} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- Galerie -->
  {gallerySection && (
    <section class="py-20 bg-cream-50">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-12 max-w-2xl mx-auto">
          {gallerySection.kicker && (
            <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{gallerySection.kicker}</div>
          )}
          <h2 class="font-display text-3xl md:text-4xl text-forest-900 leading-tight mb-4">
            {gallerySection.title}
            {gallerySection.titleAccent && (
              <><br class="sm:hidden" /><em class="not-italic text-forest-600 font-normal" style="font-family: var(--font-script);"> {gallerySection.titleAccent}</em></>
            )}
          </h2>
          {gallerySection.intro && (
            <p class="text-ink-600 leading-relaxed">{gallerySection.intro}</p>
          )}
        </div>
        <div class="columns-2 md:columns-3 gap-4 [column-fill:_balance]">
          {gallerySection.photos.map((photo) => (
            <div class="mb-4 break-inside-avoid overflow-hidden rounded-2xl shadow-sm hover:shadow-lg transition-shadow">
              <img
                src={photo.src}
                alt={photo.alt}
                class:list={[photo.aspect ?? '', 'w-full object-cover', photo.objectPos ?? '']}
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  {ctaSection && (
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="font-display text-3xl md:text-4xl text-forest-900 mb-6">
          {ctaSection.title}
        </h2>
        {ctaSection.intro && (
          <p class="text-lg text-ink-700 mb-8 leading-relaxed">
            {ctaSection.intro}
          </p>
        )}
        <div class="flex flex-wrap justify-center gap-4">
          {ctaSection.ctaPrimaryLabel && ctaSection.ctaPrimaryHref && (
            <a href={ctaSection.ctaPrimaryHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-forest-800 hover:bg-forest-900 text-cream-100 font-medium transition-colors">
              {ctaSection.ctaPrimaryLabel}
            </a>
          )}
          {ctaSection.ctaSecondaryLabel && ctaSection.ctaSecondaryHref && (
            <a href={ctaSection.ctaSecondaryHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-forest-700/40 hover:border-forest-700 text-forest-900 font-medium transition-colors">
              {ctaSection.ctaSecondaryLabel}
            </a>
          )}
        </div>
      </div>
    </section>
  )}
</Layout>
