---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { getEntry } from 'astro:content';

const entry = await getEntry('static-pages', 'faq');
if (!entry) throw new Error("Contenu manquant : src/content/static-pages/faq.md");
const { meta, pageHeader, faqCategories, ctaSection } = entry.data;

// Aplatit les Q/A pour Schema.org FAQPage (Google rich result).
const allQuestions = (faqCategories ?? []).flatMap((c) => c.questions);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allQuestions.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${site.url}/faq` },
  ],
};
---
<Layout
  title={meta.title}
  description={meta.description}
  schema={[faqSchema, breadcrumb]}
>
  {pageHeader && (
    <PageHeader
      kicker={pageHeader.kicker}
      title={pageHeader.title}
      subtitle={pageHeader.subtitle}
      breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'FAQ' }]}
    />
  )}

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-6 space-y-14">
      {(faqCategories ?? []).map((cat) => (
        <div>
          <h2 class="font-display text-2xl md:text-3xl text-forest-900 mb-6 pb-2 border-b border-forest-200">
            {cat.name}
          </h2>
          <div class="space-y-3">
            {cat.questions.map((f) => (
              <details class="group rounded-2xl bg-cream-50 border border-forest-100/60 overflow-hidden open:border-forest-300">
                <summary class="cursor-pointer px-6 py-4 font-medium text-forest-900 flex items-center justify-between gap-4 hover:bg-forest-50/50 transition-colors list-none">
                  <span>{f.q}</span>
                  <svg class="flex-none w-5 h-5 text-forest-600 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </summary>
                <div class="px-6 pb-5 text-ink-700 leading-relaxed text-sm">
                  {f.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {ctaSection && (
    <section class="py-16 bg-forest-900 text-cream-100 mt-16">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="font-display text-3xl text-cream-100 mb-4">{ctaSection.title}</h2>
        {ctaSection.intro && (
          <p class="text-cream-200/80 mb-8">{ctaSection.intro}</p>
        )}
        {ctaSection.ctaPrimaryLabel && ctaSection.ctaPrimaryHref && (
          <a href={ctaSection.ctaPrimaryHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-cream-50 text-forest-900 font-medium hover:bg-cream-100 transition-colors">
            {ctaSection.ctaPrimaryLabel}
          </a>
        )}
      </div>
    </section>
  )}
</Layout>
