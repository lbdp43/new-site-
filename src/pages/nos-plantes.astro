---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { plants } from '../data/plants';
import { site } from '../data/site';
import { getEntry } from 'astro:content';

const entry = await getEntry('static-pages', 'nos-plantes');
if (!entry) throw new Error("Contenu manquant : src/content/static-pages/nos-plantes.md");
const {
  meta,
  pageHeader,
  videoBanner,
  introParagraphs,
  listClosing,
  demarcheSection,
  ctaSection,
} = entry.data;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Nos plantes', item: `${site.url}/nos-plantes` },
  ],
};

const plantsListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Plantes et ingrédients botaniques de La Brasserie des Plantes',
  description:
    "Plantes aromatiques, racines, écorces, fleurs, agrumes, épices et fruits utilisés dans nos liqueurs artisanales. Sourcés chez nos cueilleurs et maraîchers partenaires, la plupart en agriculture biologique.",
  numberOfItems: plants.length,
  itemListElement: plants.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'DefinedTerm',
      name: p.name,
      ...(p.latin && { alternateName: p.latin }),
      description: p.description,
      inDefinedTermSet: `${site.url}/nos-plantes`,
    },
  })),
};

const schema = [breadcrumbSchema, plantsListSchema];

const familyLabels: Record<string, string> = {
  aromatique: 'Plante aromatique',
  racine: 'Racine',
  ecorce: 'Écorce',
  epice: 'Épice',
  fleur: 'Fleur',
  agrume: 'Agrume',
  fruit: 'Fruit',
  autre: 'Spécialité',
};

const familyOrder = ['aromatique', 'fleur', 'racine', 'ecorce', 'agrume', 'epice', 'fruit', 'autre'] as const;
const sortedPlants = [...plants].sort((a, b) => {
  const fa = familyOrder.indexOf(a.family as typeof familyOrder[number]);
  const fb = familyOrder.indexOf(b.family as typeof familyOrder[number]);
  if (fa !== fb) return fa - fb;
  return a.name.localeCompare(b.name, 'fr');
});

// Rendu markdown inline minimal (bold + italic) pour les paragraphes du CMS,
// évite un import lourd de `marked` pour 3 balises.
const renderInline = (s: string) =>
  s
    .replace(/\*\*(.+?)\*\*/g, '<strong class="font-medium text-forest-800">$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<Layout
  title={meta.title}
  description={meta.description}
  schema={schema}
>
  {pageHeader && (
    <PageHeader
      kicker={pageHeader.kicker}
      title={pageHeader.title}
      subtitle={pageHeader.subtitle}
      breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Nos plantes' }]}
    />
  )}

  <section class="pb-24">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Vidéo verveine -->
      {videoBanner && (
        <div class="aspect-[5/2] rounded-3xl overflow-hidden shadow-xl mb-16 bg-forest-50">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={videoBanner.poster}
            aria-label={videoBanner.alt}
            class="w-full h-full object-cover"
          >
            <source src={videoBanner.src} type="video/mp4" />
          </video>
        </div>
      )}

      <!-- Intro -->
      {introParagraphs && introParagraphs.length > 0 && (
        <div class="max-w-3xl mx-auto text-lg text-ink-700 leading-relaxed space-y-6 mb-16">
          {introParagraphs.map((p) => (
            <p set:html={renderInline(p)} />
          ))}
        </div>
      )}

      <!-- Grille plantes -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPlants.map((plant) => (
          <article class="p-7 rounded-2xl bg-cream-50 border border-forest-100/60 hover:border-forest-300 hover:shadow-lg transition-all">
            <div class="flex items-start justify-between mb-3 gap-3">
              <div class="min-w-0">
                <h2 class="font-display text-2xl text-forest-900 leading-tight">{plant.name}</h2>
                {plant.latin && (
                  <div class="text-xs italic text-ink-500 mt-1">{plant.latin}</div>
                )}
              </div>
              <span class="text-[10px] uppercase tracking-[0.15em] text-forest-600 font-medium px-2 py-1 rounded-full bg-forest-50 whitespace-nowrap">
                {familyLabels[plant.family]}
              </span>
            </div>
            {plant.role && (
              <div class="text-xs font-medium text-gold-700 mb-3 tracking-wide">
                {plant.role}
              </div>
            )}
            <p class="text-sm text-ink-700 leading-relaxed mb-4">{plant.description}</p>
            <div class="pt-3 border-t border-forest-100/80 space-y-2">
              <div class="text-xs">
                <span class="text-ink-500 uppercase tracking-wide">Dans nos liqueurs</span>
                <div class="text-forest-800 font-medium mt-0.5 leading-snug">{plant.usedIn}</div>
              </div>
              {plant.season && (
                <div class="text-xs">
                  <span class="text-ink-500 uppercase tracking-wide">Saison</span>
                  <div class="text-ink-700 mt-0.5">{plant.season}</div>
                </div>
              )}
              {plant.signature && (
                <div class="mt-3 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-gold-500/15 text-gold-700 text-[10px] font-medium tracking-wide uppercase">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 16.8l-6.2 4.5 2.4-7.4L2 9.4h7.6z"/></svg>
                  Plante signature
                </div>
              )}
            </div>
          </article>
        ))}
      </div>

      {listClosing && (
        <div class="mt-12 max-w-3xl mx-auto text-center">
          <p class="text-base md:text-lg text-ink-600 italic leading-relaxed">
            {listClosing}
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- Pourquoi ce choix / démarche -->
  {demarcheSection && (
    <section class="py-20 bg-cream-50">
      <div class="max-w-3xl mx-auto px-6">
        {demarcheSection.kicker && (
          <div class="text-xs uppercase tracking-[0.25em] text-forest-600 font-medium mb-3">{demarcheSection.kicker}</div>
        )}
        <h2 class="font-display text-3xl md:text-4xl text-forest-900 mb-6 leading-tight">
          {demarcheSection.title}
          {demarcheSection.titleAccent && (
            <><br /><em class="not-italic text-forest-600 font-normal" style="font-family: var(--font-script);">{demarcheSection.titleAccent}</em></>
          )}
        </h2>
        <div class="space-y-5 text-lg text-ink-700 leading-relaxed">
          {demarcheSection.paragraphs.map((p) => (
            <p set:html={renderInline(p)} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  {ctaSection && (
    <section class="py-20 bg-forest-900 text-cream-100">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="font-display text-3xl md:text-4xl mb-6">
          {ctaSection.title}
        </h2>
        {ctaSection.intro && (
          <p class="text-cream-200/80 leading-relaxed text-lg mb-8 max-w-xl mx-auto">
            {ctaSection.intro}
          </p>
        )}
        <div class="flex flex-wrap justify-center gap-4">
          {ctaSection.ctaPrimaryLabel && ctaSection.ctaPrimaryHref && (
            <a href={ctaSection.ctaPrimaryHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-cream-50 hover:bg-cream-100 text-forest-900 font-medium transition-colors">
              {ctaSection.ctaPrimaryLabel}
            </a>
          )}
          {ctaSection.ctaSecondaryLabel && ctaSection.ctaSecondaryHref && (
            <a href={ctaSection.ctaSecondaryHref} class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-cream-100/40 hover:border-cream-100/70 text-cream-100 font-medium transition-colors">
              {ctaSection.ctaSecondaryLabel}
            </a>
          )}
        </div>
      </div>
    </section>
  )}
</Layout>
