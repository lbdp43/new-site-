---
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgeGate from '../components/AgeGate.astro';
import MiniCartDrawer from '../components/cart/MiniCartDrawer';
import {
  getLangFromUrl,
  getOgLocale,
  getHtmlLang,
  getHreflangLinks,
  alternateLangPath,
  type Lang,
} from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** JSON-LD structured data (object or array of objects) injecté dans <head>. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Type OpenGraph. Par défaut 'website'. Utiliser 'article' pour les blogs. */
  ogType?: 'website' | 'article' | 'product';
  /** Langue forcée (override de la détection par URL). Utile pour pages dynamiques. */
  lang?: Lang;
  /** Page avec hero scroll-expansion (home FR/EN). Quand true, le bandeau
   *  principal du header est caché tant qu'on n'a pas scrollé — pour laisser
   *  le hero respirer. Sur les autres pages, le header reste visible en
   *  permanence. */
  hasHero?: boolean;
  /** Image à précharger en priorité (candidat LCP). Typiquement le poster
   *  d'une vidéo hero ou la première image au-dessus de la ligne de flottaison.
   *  Génère un <link rel="preload" as="image" fetchpriority="high"> dans le head. */
  preloadImage?: string;
  /** Vidéo à précharger (en plus de son poster) — uniquement pour le hero
   *  critique above-the-fold. Génère un <link rel="preload" as="video">. */
  preloadVideo?: string;
}

const {
  title,
  description = site.defaultDescription,
  canonical,
  ogImage = site.defaultOgImage,
  noindex = false,
  schema,
  ogType = 'website',
  lang: langProp,
  hasHero = false,
  preloadImage,
  preloadVideo,
} = Astro.props;

// Détection de la langue — priorité à la prop, sinon détection par URL
const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const htmlLang = getHtmlLang(lang);
const ogLocale = getOgLocale(lang);

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// hreflang — getHreflangLinks gère maintenant les 4 langues nativement et
// recalcule le chemin FR canonique en interne. On lui passe directement la
// vraie langue source pour qu'il puisse générer les alternates EN/ES/IT
// correctement, y compris quand la page courante est /es/ ou /it/.
const alternates = getHreflangLinks(Astro.url.pathname, lang, site.url);

// og:locale:alternate — on déclare toutes les autres langues du site
// (et pas seulement EN), aligné avec hreflang.
const otherLocales: Lang[] = (['fr', 'en', 'es', 'it'] as Lang[]).filter((l) => l !== lang);
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }

    <!-- hreflang — versions linguistiques alternatives -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {otherLocales.map((l) => (
      <meta property="og:locale:alternate" content={getOgLocale(l)} />
    ))}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- LCP booster : préchargement du poster vidéo / image hero en haute priorité -->
    {preloadImage && (
      <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
    )}
    {preloadVideo && (
      <link rel="preload" as="video" href={preloadVideo} type="video/mp4" />
    )}

    <!-- Fonts (locaux — déclarés dans global.css, WOFF2 avec fallback TTF) -->
    <link rel="preload" href="/fonts/Joane-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BarlowCondensed-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BarlowCondensed-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SunshineScript.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/brand/logo-lbdp.webp" />

    <!--
      Google Analytics 4 avec Consent Mode v2
      ────────────────────────────────────────
      Le script gtag est chargé en `denied` par défaut pour tous les stockages
      (analytics, ad, functional, security, personalization). Aucun cookie n'est
      posé, aucune donnée n'est envoyée tant que le visiteur n'a pas donné son
      consentement dans l'AgeGate. Quand le consentement est donné (custom event
      `lbdp:consent-updated` émis par AgeGate.astro), on bascule `analytics_storage`
      à `granted` et on envoie le page_view.

      Wrapper `window.lbdpTrack(name, params)` exposé pour les composants React
      (AddToCartButton, checkout, etc.) — no-op silencieux si pas de consentement.
    -->
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',functionality_storage:'denied',personalization_storage:'denied',security_storage:'granted',wait_for_update:500});gtag('config','${site.googleAnalytics.measurementId}',{anonymize_ip:true,send_page_view:false});window.lbdpTrack=function(name,params){try{if(window.__lbdpAnalyticsGranted)gtag('event',name,params||{});}catch(e){}};window.addEventListener('lbdp:consent-updated',function(e){var granted=!!(e&&e.detail&&e.detail.analytics);window.__lbdpAnalyticsGranted=granted;gtag('consent','update',{ad_storage:granted?'granted':'denied',ad_user_data:granted?'granted':'denied',ad_personalization:granted?'granted':'denied',analytics_storage:granted?'granted':'denied'});if(granted)gtag('event','page_view');});`} />
    <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalytics.measurementId}`}></script>

    {schema && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema)}
      />
    )}
  </head>
  <body class="min-h-screen flex flex-col" data-has-hero={hasHero ? 'true' : undefined}>
    <AgeGate />
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- Mini-panier slide-in (overlay sur toutes les pages) -->
    <MiniCartDrawer client:idle />
  </body>
</html>
